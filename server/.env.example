PORT=5051
DB_HOST=127.0.0.1
# Default MySQL port is 3306. Docker often publishes 3307->3306 on the host — then use:
# DB_PORT=3307
DB_USER=root
# Docker: must match MYSQL_ROOT_PASSWORD from `docker run` / compose (empty → "Access denied ... using password: NO")
DB_PASSWORD=your_mysql_root_password_here
DB_NAME=f1_dashboard
# If TCP to 127.0.0.1:3306 fails (ECONNREFUSED) but a GUI still connects, MySQL may only be on a Unix socket. Example (Homebrew on Mac):
# DB_SOCKET=/tmp/mysql.sock
